timer.start()
browser.launch(headless=true)
browser.navigate(url="data:text/html,<div id='scope'><button id='state'>waiting</button></div>")
watch(source="browser", selector="#scope", name="ready")
browser.evaluate(expression="setTimeout(()=>document.getElementById('state').textContent='ready',80);true")
wait_until(watch="ready", condition="text", text="ready", role="button", timeout=2000)
observe(watch="ready")
watch.close(name="ready")
browser.close()
timer.stop()
